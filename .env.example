# Copy to .env and fill in. TESTNET ONLY — never put mainnet keys here.

# --- Endpoints ---
HL_TESTNET_API=https://api.hyperliquid-testnet.xyz
HYPEREVM_RPC=https://rpc.hyperliquid-testnet.xyz/evm
CHAIN_ID=998

# --- Keys / addresses (testnet) ---
# Operator key is used to sign HL orders AND HyperEVM vault txs (deployer + operator).
OPERATOR_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
FELIX_WALLET=0xYOUR_OPERATOR_ADDRESS

# Set after deploy (scripts/deploy.py writes deployment.json with the address)
VAULT_ADDRESS=

# Deploy inputs
USDC_TESTNET_ADDRESS=0xUSDC_ON_HYPEREVM_TESTNET
FELIX_TREASURY_TESTNET=0xFELIX_TREASURY_ADDRESS
OPERATOR_ADDRESS=

# --- Strategy tuning (optional; sensible defaults in bot/config.py) ---
# Mainnet production values:
#   MIN_VIABLE_APY=9.0  MAX_CV=0.75  MIN_PCT_TIME_POSITIVE=80.0
#   MIN_PCT_TIME_ABOVE_9=60.0  CAPACITY_RATING_FILTER=Reliable
# Testnet / demo — accept any market with any funding history:
MIN_VIABLE_APY=0.0
MAX_CV=9999.0
MIN_PCT_TIME_POSITIVE=0.0
MIN_PCT_TIME_ABOVE_9=0.0
CAPACITY_RATING_FILTER=Reliable,Moderate,Unreliable
MAX_POSITION_SIZE_PCT=0.45
MAX_TVL_PCT_PER_MARKET=0.30
REBALANCE_THRESHOLD=0.05

# --- Behaviour ---
# DRY_RUN=true makes the bot simulate perp fills instead of placing real testnet orders.
DRY_RUN=false
LOG_FILE=bot/operator.log
